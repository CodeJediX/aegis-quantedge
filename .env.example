# Offline research needs no API keys or environment variables.
# Hosted SQL persistence: set these only in your hosting provider's secrets.
# AEGIS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
# AEGIS_ADMIN_KEY=generate-a-long-random-value
# AEGIS_REQUIRE_DATABASE=1
# Optional presentation-authoring setup only; never insert a live secret here.
# ARTIFACT_TOOL_MODULE=/absolute/path/to/@oai/artifact-tool/dist/artifact_tool.mjs
# AEGIS_DECK_BUILD=/absolute/path/to/private/render/build
